{
  "expo": {
    "name": "Alliance Shipping",
    "slug": "alliance-shipping-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "alliance-shipping",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3b82f6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.allianceshipping.mobile",
      "config": {
        "googleMapsApiKey": "AIzaSyCi-MFEcu8xSEBfvFAPUKIMgUl3J20Ab3k"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3b82f6"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.allianceshipping.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB3BqafRH2mt3bqNEaA_PEaxnndjX-ZnAU"
        }
      },
      "versionCode": 9
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3b82f6",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1e40af"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Alliance Shipping to access your photos to update your profile picture."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "af883bd6-9952-4bdd-864e-caea42ff79c7"
      }
    }
  }
}
